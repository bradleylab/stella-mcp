{
  "schema_version": 2,
  "system_prompt": "Complete the user's Stella modeling task through the available MCP tools. Use the exact model IDs and output paths requested. Treat tool errors as recoverable evidence: inspect the error, correct the request, and continue. Do not claim an operation succeeded unless its tool result confirms success. Finish with a concise account of the model and analysis completed.",
  "model_request": {
    "temperature": 0,
    "seed": 20260713,
    "max_completion_tokens": 4096
  },
  "max_tool_rounds": 12,
  "runs_per_scenario": 3,
  "scenarios": [
    {
      "id": "construct_growth",
      "description": "Plan and complete a build, validation, simulation, rendering, and strict save workflow from a user-level specification.",
      "requires": ["sim"],
      "prompt": "Create a Stella model named Agent Evaluation Growth with model ID agent_growth. Simulate from year 0 through year 5 with a time step of 1 using Euler integration. The Population stock starts at 100 people. The growth inflow is Population * growth_rate in people/Year, and growth_rate is 0.1 1/Year. Validate the model, run it, render its diagram, and save it in strict mode to ${ARTIFACT_DIR}/agent_growth.stmx.",
      "required_tool_order": [
        "build_model",
        "validate_model",
        "simulate",
        "render_diagram",
        "save_model"
      ],
      "checks": [
        {
          "tool": "inspect_model",
          "arguments": {"model_id": "agent_growth", "include_validation": true},
          "expect_error": false,
          "expectations": [
            {"path": "model.name", "operator": "exact", "value": "Agent Evaluation Growth"},
            {"path": "model.sim_specs.start", "operator": "exact", "value": 0},
            {"path": "model.sim_specs.stop", "operator": "exact", "value": 5},
            {"path": "model.sim_specs.dt", "operator": "finite"},
            {"path": "model.sim_specs.method", "operator": "one_of", "values": ["Euler", "euler"]},
            {"path": "model.sim_specs.time_units", "operator": "normalized_time_unit", "value": "Years"},
            {"path": "model.counts.stocks", "operator": "exact", "value": 1},
            {"path": "model.counts.flows", "operator": "exact", "value": 1},
            {"path": "model.counts.auxiliaries", "operator": "exact", "value": 1},
            {"path": "model.variables.stocks.0.name", "operator": "exact", "value": "Population"},
            {"path": "model.variables.stocks.0.initial_value", "operator": "exact", "value": "100"},
            {"path": "model.variables.flows.0.name", "operator": "exact", "value": "growth"},
            {"path": "model.variables.flows.0.equation", "operator": "exact", "value": "Population * growth_rate"},
            {"path": "model.variables.flows.0.to_stock", "operator": "exact", "value": "Population"},
            {"path": "model.variables.auxiliaries.0.name", "operator": "exact", "value": "growth_rate"},
            {"path": "model.variables.auxiliaries.0.equation", "operator": "exact", "value": "0.1"},
            {"path": "validation.passed", "operator": "exact", "value": true}
          ]
        }
      ],
      "artifacts": ["agent_growth.stmx"]
    },
    {
      "id": "modify_sir_template",
      "description": "Plan and complete a template load, parameter edit, validation, simulation, rendering, and strict save workflow.",
      "requires": ["sim"],
      "prompt": "Load the built-in SIR template as model ID agent_sir. Change transmission_rate to 0.2 while leaving recovery_rate and the initial stocks unchanged. Validate and simulate the edited model, render the diagram, and save it in strict mode to ${ARTIFACT_DIR}/agent_sir.stmx.",
      "required_tool_order": [
        "load_template",
        "update_aux",
        "validate_model",
        "simulate",
        "render_diagram",
        "save_model"
      ],
      "checks": [
        {
          "tool": "inspect_model",
          "arguments": {"model_id": "agent_sir", "include_validation": true},
          "expect_error": false,
          "expectations": [
            {"path": "model.counts.stocks", "operator": "exact", "value": 3},
            {"path": "model.counts.flows", "operator": "exact", "value": 2},
            {"path": "model.counts.auxiliaries", "operator": "exact", "value": 3},
            {"path": "model.variables.auxiliaries.0.name", "operator": "exact", "value": "population total"},
            {"path": "model.variables.auxiliaries.0.equation", "operator": "exact", "value": "Susceptible + Infected + Recovered"},
            {"path": "model.variables.auxiliaries.1.name", "operator": "exact", "value": "recovery rate"},
            {"path": "model.variables.auxiliaries.1.equation", "operator": "exact", "value": "0.1"},
            {"path": "model.variables.auxiliaries.2.name", "operator": "exact", "value": "transmission rate"},
            {"path": "model.variables.auxiliaries.2.equation", "operator": "exact", "value": "0.2"},
            {"path": "validation.passed", "operator": "exact", "value": true}
          ]
        }
      ],
      "artifacts": ["agent_sir.stmx"]
    },
    {
      "id": "analyze_accumulator",
      "description": "Plan and complete an imported-model inspection, baseline run, scenario comparison, sensitivity analysis, and strict save workflow.",
      "requires": ["sim"],
      "prompt": "Read ${REPO_ROOT}/tests/fixtures/compat_corpus/stella_4_1_1_accumulator.stmx as model ID agent_analysis and inspect it. Run the baseline simulation. Compare it with a scenario named double rate that sets rate to 2 and save the comparison CSV to ${ARTIFACT_DIR}/agent_accumulator_scenarios.csv. Then run a one-at-a-time sensitivity analysis for rate from 1 through 3 at 3 evenly spaced values, using the final Accumulator value as the output, and save the sweep to ${ARTIFACT_DIR}/agent_accumulator_sensitivity.csv. Save the model in strict mode to ${ARTIFACT_DIR}/agent_accumulator.stmx and summarize the numerical findings.",
      "required_tool_order": [
        "read_model",
        "inspect_model",
        "simulate",
        "compare_scenarios",
        "sensitivity_analysis",
        "save_model"
      ],
      "checks": [
        {
          "tool": "inspect_model",
          "arguments": {"model_id": "agent_analysis", "include_validation": true},
          "expect_error": false,
          "expectations": [
            {"path": "model.sim_specs.start", "operator": "exact", "value": 0},
            {"path": "model.sim_specs.stop", "operator": "exact", "value": 4},
            {"path": "model.sim_specs.dt", "operator": "finite"},
            {"path": "model.sim_specs.method", "operator": "one_of", "values": ["Euler", "euler"]},
            {"path": "model.counts.stocks", "operator": "exact", "value": 1},
            {"path": "model.counts.flows", "operator": "exact", "value": 1},
            {"path": "model.counts.auxiliaries", "operator": "exact", "value": 1},
            {"path": "model.variables.stocks.0.name", "operator": "non_empty"},
            {"path": "model.variables.flows.0.name", "operator": "exact", "value": "input"},
            {"path": "model.variables.auxiliaries.0.name", "operator": "exact", "value": "rate"},
            {"path": "validation.passed", "operator": "exact", "value": true}
          ]
        }
      ],
      "artifacts": [
        "agent_accumulator_scenarios.csv",
        "agent_accumulator_sensitivity.csv",
        "agent_accumulator.stmx"
      ]
    }
  ]
}
