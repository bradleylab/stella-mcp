{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "build_growth",
      "description": "Build, validate, render, and save a one-stock growth model.",
      "requires": [],
      "artifacts": ["growth.stmx"],
      "steps": [
        {
          "tool": "build_model",
          "arguments": {
            "name": "Evaluation Growth",
            "model_id": "eval_growth",
            "sim_specs": {
              "start": 0,
              "stop": 5,
              "dt": 1,
              "method": "Euler",
              "time_units": "Years"
            },
            "stocks": [
              {"name": "Population", "initial_value": "100", "units": "people"}
            ],
            "flows": [
              {
                "name": "growth",
                "equation": "Population * growth_rate",
                "to_stock": "Population",
                "units": "people/Year"
              }
            ],
            "auxs": [
              {"name": "growth_rate", "equation": "0.1", "units": "1/Year"}
            ]
          },
          "expect": {
            "is_error": false,
            "fields": {
              "model_id": "eval_growth",
              "validation.passed": true
            }
          }
        },
        {
          "tool": "validate_model",
          "arguments": {"model_id": "eval_growth"},
          "expect": {"is_error": false, "fields": {"passed": true}}
        },
        {
          "tool": "render_diagram",
          "arguments": {"model_id": "eval_growth"},
          "expect": {"is_error": false, "nonempty": ["svg"]}
        },
        {
          "tool": "save_model",
          "arguments": {
            "model_id": "eval_growth",
            "filepath": "${ARTIFACT_DIR}/growth.stmx",
            "compat_mode": "strict"
          },
          "expect": {"is_error": false}
        }
      ]
    },
    {
      "id": "template_sir",
      "description": "Load the SIR template, validate it, simulate it, and save it.",
      "requires": ["sim"],
      "artifacts": ["sir.stmx", "sir.csv"],
      "steps": [
        {
          "tool": "load_template",
          "arguments": {"template_name": "sir", "model_id": "eval_sir"},
          "expect": {
            "is_error": false,
            "fields": {"model_id": "eval_sir", "template.name": "sir"}
          }
        },
        {
          "tool": "validate_model",
          "arguments": {"model_id": "eval_sir"},
          "expect": {"is_error": false, "fields": {"passed": true}}
        },
        {
          "tool": "simulate",
          "arguments": {
            "model_id": "eval_sir",
            "max_points": 101,
            "save_results_csv": "${ARTIFACT_DIR}/sir.csv"
          },
          "expect": {
            "is_error": false,
            "fields": {"model_id": "eval_sir"},
            "nonempty": ["series"]
          }
        },
        {
          "tool": "save_model",
          "arguments": {
            "model_id": "eval_sir",
            "filepath": "${ARTIFACT_DIR}/sir.stmx",
            "compat_mode": "strict"
          },
          "expect": {"is_error": false}
        }
      ]
    },
    {
      "id": "import_roundtrip",
      "description": "Import a namespaced XMILE fixture, inspect it, and export it strictly.",
      "requires": [],
      "artifacts": ["modern_namespaced_roundtrip.stmx"],
      "steps": [
        {
          "tool": "read_model",
          "arguments": {
            "filepath": "${REPO_ROOT}/tests/fixtures/compat_corpus/modern_namespaced.stmx",
            "model_id": "eval_import",
            "compat_mode": "strict"
          },
          "expect": {"is_error": false}
        },
        {
          "tool": "inspect_model",
          "arguments": {"model_id": "eval_import", "include_validation": true},
          "expect": {
            "is_error": false,
            "fields": {"model.model_id": "eval_import", "validation.passed": true}
          }
        },
        {
          "tool": "save_model",
          "arguments": {
            "model_id": "eval_import",
            "filepath": "${ARTIFACT_DIR}/modern_namespaced_roundtrip.stmx",
            "auto_layout": false,
            "compat_mode": "strict"
          },
          "expect": {"is_error": false}
        }
      ]
    },
    {
      "id": "error_recovery",
      "description": "Observe a structured batch error and recover in the same session.",
      "requires": [],
      "artifacts": [],
      "steps": [
        {
          "tool": "build_model",
          "arguments": {
            "name": "Invalid Evaluation Model",
            "model_id": "eval_invalid",
            "stocks": [{"name": "Known", "initial_value": "1"}],
            "flows": [
              {"name": "broken", "equation": "1", "from_stock": "Missing"}
            ]
          },
          "expect": {
            "is_error": true,
            "fields": {"error.code": "invalid_input", "error.stage": "flows"}
          }
        },
        {
          "tool": "build_model",
          "arguments": {
            "name": "Recovered Evaluation Model",
            "model_id": "eval_recovered",
            "stocks": [{"name": "Known", "initial_value": "1"}]
          },
          "expect": {
            "is_error": false,
            "fields": {"model_id": "eval_recovered", "validation.passed": true}
          }
        }
      ]
    },
    {
      "id": "analysis_stack",
      "description": "Exercise simulation, scenarios, sensitivity, and calibration on one model.",
      "requires": ["sim"],
      "artifacts": ["analysis_accumulator.stmx"],
      "steps": [
        {
          "tool": "build_model",
          "arguments": {
            "name": "Evaluation Accumulator",
            "model_id": "eval_analysis",
            "sim_specs": {"start": 0, "stop": 4, "dt": 1, "method": "Euler"},
            "stocks": [{"name": "Accumulator", "initial_value": "0"}],
            "flows": [
              {"name": "input", "equation": "rate", "to_stock": "Accumulator"}
            ],
            "auxs": [{"name": "rate", "equation": "1"}]
          },
          "expect": {
            "is_error": false,
            "fields": {"model_id": "eval_analysis", "validation.passed": true}
          }
        },
        {
          "tool": "simulate",
          "arguments": {"model_id": "eval_analysis"},
          "expect": {"is_error": false, "nonempty": ["series"]}
        },
        {
          "tool": "compare_scenarios",
          "arguments": {
            "model_id": "eval_analysis",
            "scenarios": [
              {"name": "higher rate", "overrides": {"rate": 2}}
            ]
          },
          "expect": {"is_error": false, "nonempty": ["scenarios"]}
        },
        {
          "tool": "sensitivity_analysis",
          "arguments": {
            "model_id": "eval_analysis",
            "parameters": [{"name": "rate", "start": 1, "stop": 3, "steps": 3}],
            "output": {"variable": "Accumulator", "metric": "final"}
          },
          "expect": {
            "is_error": false,
            "fields": {"total_runs": 3},
            "nonempty": ["parameters"]
          }
        },
        {
          "tool": "calibrate",
          "arguments": {
            "model_id": "eval_analysis",
            "observations": {
              "time": [0, 1, 2, 3, 4],
              "targets": {"Accumulator": [0, 3, 6, 9, 12]}
            },
            "parameters": [{"name": "rate", "initial": 1, "min": 0, "max": 5}],
            "max_nfev": 100
          },
          "expect": {
            "is_error": false,
            "fields": {"optimizer.converged": true, "parameters.0.name": "rate"},
            "finite": ["parameters.0.fitted", "objective.final"]
          }
        },
        {
          "tool": "save_model",
          "arguments": {
            "model_id": "eval_analysis",
            "filepath": "${ARTIFACT_DIR}/analysis_accumulator.stmx",
            "compat_mode": "strict"
          },
          "expect": {"is_error": false}
        }
      ]
    }
  ]
}
