					<to>recovery</to>
				</connector>
				<connector uid="6" angle="29.50960913893892">
					<from>Infected</from>
					<to>recovery</to>
				</connector>
				<connector uid="7" angle="50.074081788276885">
					<from>Susceptible</from>
					<to>population_total</to>
				</connector>
				<connector uid="8" angle="104.4855306118299">
					<from>Infected</from>
					<to>population_total</to>
				</connector>
				<connector uid="9" angle="158.22643642596077">
