	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.0015" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>100</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" saved_runs="5" keep="false" rifp="true"/>
	<model>
		<variables>
			<stock name="Surface N">
				<eqn>100</eqn>
				<inflow>upwelling</inflow>
				<outflow>downwelling</outflow>
				<outflow>uptake</outflow>
				<non_negative/>
			</stock>
			<stock name="Deep N">
				<eqn>1000</eqn>
				<inflow>downwelling</inflow>
				<inflow>remin</inflow>
				<outflow>upwelling</outflow>
				<non_negative/>
			</stock>
			<flow name="upwelling">
				<eqn>upwelling_rate * Deep_N</eqn>
				<non_negative/>
			</flow>
			<flow name="downwelling">
				<eqn>downwelling_rate * Surface_N</eqn>
				<non_negative/>
			</flow>
			<flow name="uptake">
				<eqn>uptake_rate * Surface_N</eqn>
				<non_negative/>
			</flow>
			<flow name="remin">
				<eqn>remin_rate * Deep_N</eqn>
				<non_negative/>
			</flow>
			<aux name="upwelling rate">
				<eqn>0.03</eqn>
			</aux>
			<aux name="downwelling rate">
				<eqn>0.03</eqn>
			</aux>
			<aux name="uptake rate">
				<eqn>0.04</eqn>
			</aux>
			<aux name="remin rate">
				<eqn>0.02</eqn>
			</aux>
		</variables>
