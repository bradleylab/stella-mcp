						<shape type="circle" radius="18"/>
					</aux>
					<connector color="#FF007F" background="white" font_color="#FF007F" font_size="9pt" isee:thickness="1"/>
				</style>
				<stock x="1015" y="584" width="45" height="35" name="Prey"/>
