	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.0015" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>100</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<ns0:prefs xmlns:ns0="http://iseesystems.com/XMILE" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" saved_runs="5" keep="false" rifp="true" />
	<model>
		<variables>
			<stock name="Atmosphere C">
				<eqn>800</eqn>
				<inflow>respiration</inflow>
				<outflow>photosynthesis</outflow>
				<non_negative/>
			</stock>
			<stock name="Land C">
				<eqn>2000</eqn>
				<inflow>photosynthesis</inflow>
				<outflow>respiration</outflow>
				<non_negative/>
			</stock>
			<flow name="photosynthesis">
				<eqn>photosynthesis_rate * Atmosphere_C</eqn>
				<non_negative/>
			</flow>
			<flow name="respiration">
				<eqn>respiration_rate * Land_C</eqn>
				<non_negative/>
			</flow>
			<aux name="photosynthesis rate">
				<eqn>0.05</eqn>
			</aux>
			<aux name="respiration rate">
				<eqn>0.02</eqn>
			</aux>
		</variables>
