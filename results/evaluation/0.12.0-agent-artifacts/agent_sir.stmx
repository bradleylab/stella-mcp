					</pts>
				</flow>
				<flow x="934.3996698852932" y="417" name="recovery">
					<pts>
						<pt x="778.2572008322006" y="518.2103877102478"/>
						<pt x="1090.5421389383857" y="315.9891869798381"/>
					</pts>
				</flow>
				<aux x="237" y="866" name="beta"/>
