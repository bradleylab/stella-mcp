<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>Scalar Graphical Function</name>
		<uuid>831e312f-4828-5d42-b14d-e694977485a0</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.3" isee:build_number="1954" isee:saved_by_v1="true" lang="en">Stella Professional</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.0015" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>10</stop>
		<dt>1</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" saved_runs="5" keep="false" rifp="true"/>
	<model>
		<variables>
			<stock name="Accumulated response">
				<eqn>0</eqn>
				<inflow>response_input</inflow>
				<non_negative/>
			</stock>
			<flow name="response input">
				<eqn>&quot;seasonal multiplier&quot;</eqn>
				<non_negative/>
			</flow>
			<aux name="seasonal multiplier">
				<eqn>TIME</eqn>
				<gf type="continuous">
					<xpts>0,5,10</xpts>
					<yscale min="0" max="1"/>
					<ypts>0,1,0</ypts>
				</gf>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
			</style>
			<view isee:show_pages="false" background="white" page_width="768" page_height="596" isee:page_cols="1" isee:page_rows="1" isee:popup_graphs_are_comparative="true" type="stock_flow">
				<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
					<stock color="blue" background="white" font_color="blue" font_size="9pt" label_side="top">
						<shape type="rectangle" width="45" height="35"/>
					</stock>
					<flow color="blue" background="white" font_color="blue" font_size="9pt" label_side="bottom"/>
					<aux color="blue" background="white" font_color="blue" font_size="9pt" label_side="bottom">
						<shape type="circle" radius="18"/>
					</aux>
					<group color="#666666" background="#F5F5F5" font_color="black" font_size="9pt" label_side="top"/>
					<connector color="#FF007F" background="white" font_color="#FF007F" font_size="9pt" isee:thickness="1"/>
				</style>
				<stock x="430" y="250" name="Accumulated response"/>
				<flow x="280" y="250" name="response input">
					<pts>
						<pt x="270.0" y="250.0"/>
						<pt x="408.0" y="250.0"/>
					</pts>
				</flow>
				<aux x="130" y="120" name="seasonal multiplier"/>
				<connector uid="1" angle="-40.91438322002513">
					<from>seasonal_multiplier</from>
					<to>response_input</to>
				</connector>
			</view>
		</views>
	</model>
</xmile>