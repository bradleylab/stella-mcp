	<model_units/>
	<model>
		<variables>
			<stock name="Predator">
				<eqn>20</eqn>
				<inflow>predator_births</inflow>
				<outflow>predator_deaths</outflow>
				<non_negative/>
			</stock>
			<stock name="Prey">
				<eqn>100</eqn>
				<inflow>prey_births</inflow>
				<outflow>predation</outflow>
				<non_negative/>
			</stock>
			<flow name="predation">
				<eqn>predation_rate * Prey * Predator</eqn>
				<non_negative/>
			</flow>
			<flow name="predator births">
				<eqn>predator_efficiency * predation_rate * Prey * Predator</eqn>
				<non_negative/>
			</flow>
			<flow name="predator deaths">
				<eqn>predator_death_rate * Predator</eqn>
				<non_negative/>
			</flow>
			<flow name="prey births">
				<eqn>prey_birth_rate * Prey</eqn>
				<non_negative/>
			</flow>
			<aux name="predation rate">
				<eqn>0.02</eqn>
			</aux>
			<aux name="predator death rate">
				<eqn>0.4</eqn>
			</aux>
			<aux name="predator efficiency">
				<eqn>0.01</eqn>
			</aux>
			<aux name="prey birth rate">
				<eqn>0.5</eqn>
			</aux>
		</variables>
