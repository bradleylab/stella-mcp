<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>Exponential Growth</name>
		<uuid>7a1adcb2-575c-54cc-8a57-72293665a92d</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.3" isee:build_number="1954" isee:saved_by_v1="true" lang="en">Stella Professional</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.0015" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>100</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<ns0:prefs xmlns:ns0="http://iseesystems.com/XMILE" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" saved_runs="5" keep="false" rifp="true" />
	<model>
		<variables>
			<stock name="Population">
				<eqn>100</eqn>
				<inflow>growth</inflow>
				<non_negative/>
			</stock>
			<flow name="growth">
				<eqn>Population * growth_rate</eqn>
				<non_negative/>
			</flow>
			<aux name="growth rate">
				<eqn>0.1</eqn>
			</aux>
		</variables>
		<views>
			<ns0:style xmlns:ns0="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
										<ns0:text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt" />
									</ns0:style>
			<view isee:show_pages="false" background="white" page_width="768" page_height="596" isee:page_cols="1" isee:page_rows="1" isee:popup_graphs_are_comparative="true" type="stock_flow">
				<ns0:style xmlns:ns0="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:ns1="http://iseesystems.com/XMILE" color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
													<ns0:stock color="blue" background="white" font_color="blue" font_size="9pt" label_side="top">
														<ns0:shape type="rectangle" width="45" height="35" />
													</ns0:stock>
													<ns0:flow color="blue" background="white" font_color="blue" font_size="9pt" label_side="bottom" />
													<ns0:aux color="blue" background="white" font_color="blue" font_size="9pt" label_side="bottom">
														<ns0:shape type="circle" radius="18" />
													</ns0:aux>
													<ns0:connector color="#FF007F" background="white" font_color="#FF007F" font_size="9pt" ns1:thickness="1" />
												</ns0:style>
				<stock x="194.0" y="100.0" name="Population" label_side="top"/>
				<flow x="102.0" y="100.0" name="growth" label_side="bottom">
					<pts>
						<pt x="32.0" y="100.0"/>
						<pt x="172.0" y="100.0"/>
					</pts>
				</flow>
				<aux x="102.0" y="50.0" name="growth rate" label_side="bottom"/>
				<connector uid="1" angle="-180.0">
					<from>Population</from>
					<to>growth</to>
					<pts>
						<pt x="172.0" y="100.0"/>
						<pt x="142.0" y="100.0"/>
						<pt x="112.0" y="100.0"/>
					</pts>
				</connector>
				<connector uid="2" angle="-90.0">
					<from>growth_rate</from>
					<to>growth</to>
					<pts>
						<pt x="102.0" y="68.0"/>
						<pt x="102.0" y="79.0"/>
						<pt x="102.0" y="90.0"/>
					</pts>
				</connector>
			</view>
		</views>
	</model>
</xmile>